<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="using:Orbit.Controls"
        x:Class="Orbit.MainWindow"
        Width="540" Height="72"
        MinWidth="540" MaxWidth="540"
        MinHeight="72" MaxHeight="72"
        WindowDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        CanResize="False"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="5">
    <Border CornerRadius="18" BorderThickness="1" BorderBrush="{StaticResource LineBrush}" Background="{StaticResource CanvasBrush}" IsHitTestVisible="False">
      <Border.Effect>
        <DropShadowEffect BlurRadius="18" Color="#99000000" Opacity="0.55" OffsetX="0" OffsetY="7" />
      </Border.Effect>
    </Border>
    <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" Margin="17,0,16,0">
      <Image Source="avares://Orbit/Assets/orbit_logo.png" Width="108" Height="38" Stretch="Uniform" VerticalAlignment="Center" />

      <Border Grid.Column="1" Width="1" Height="26" Background="{StaticResource LineBrush}" Margin="20,0" />

      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
        <Button x:Name="ClipButton" Width="40" Height="40" ToolTip.Tip="Video clipping" Click="OnClipClick" AutomationProperties.Name="Video clipping">
          <icons:OrbitIcon Kind="Clip" Width="20" Height="20" Stroke="{StaticResource IconBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
        </Button>
        <Button x:Name="ScreenshotButton" Width="40" Height="40" ToolTip.Tip="Screenshots" Click="OnScreenshotClick" AutomationProperties.Name="Screenshots">
          <icons:OrbitIcon Kind="Screenshot" Width="20" Height="20" Stroke="{StaticResource IconBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
        </Button>
        <Button x:Name="PerformanceButton" Width="40" Height="40" ToolTip.Tip="PC performance" Click="OnPerformanceClick" AutomationProperties.Name="PC performance">
          <icons:OrbitIcon Kind="Performance" Width="20" Height="20" Stroke="{StaticResource IconBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
        </Button>
      </StackPanel>

      <Border Grid.Column="3" Width="1" Height="26" Background="{StaticResource LineBrush}" Margin="18,0" />

      <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
        <Button Classes="primary" Width="40" Height="40" ToolTip.Tip="New widgets" Click="OnWidgetsClick" AutomationProperties.Name="New widgets">
          <icons:OrbitIcon Kind="Add" Width="18" Height="18" Stroke="White" />
        </Button>
        <Button Width="40" Height="40" ToolTip.Tip="Settings" Click="OnSettingsClick" AutomationProperties.Name="Settings">
          <icons:OrbitIcon Kind="Settings" Width="18" Height="18" Stroke="{StaticResource IconBrush}" />
        </Button>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
