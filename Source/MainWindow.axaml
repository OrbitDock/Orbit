<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="using:Orbit.Controls"
        x:Class="Orbit.MainWindow"
        Width="540" Height="72"
        MinWidth="540" MaxWidth="540"
        MinHeight="72" MaxHeight="72"
        WindowDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        CanResize="False"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="5">
    <Border CornerRadius="18" BorderThickness="1" BorderBrush="{StaticResource LineBrush}" Background="{StaticResource CanvasBrush}" IsHitTestVisible="False">
    </Border>
    <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" Margin="17,0,16,0">
      <Image Source="avares://Orbit/Assets/orbit_logo.png" Width="108" Height="38" Stretch="Uniform" VerticalAlignment="Center" />

      <Border Grid.Column="1" Width="1" Height="26" Background="{StaticResource LineBrush}" Margin="16,0" />

      <StackPanel Grid.Column="2" x:Name="WidgetButtons" Orientation="Horizontal" Height="40" VerticalAlignment="Center" HorizontalAlignment="Left">
        <Button Classes="overlay-icon-button" x:Name="ClipButton" ToolTip.Tip="Video clipping" Click="OnClipClick" AutomationProperties.Name="Video clipping">
          <Grid Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center">
            <icons:OrbitIcon Kind="Clip" Width="20" Height="20" Stroke="{StaticResource IconBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Grid>
        </Button>
        <Button Classes="overlay-icon-button" x:Name="ScreenshotButton" ToolTip.Tip="Screenshots" Click="OnScreenshotClick" AutomationProperties.Name="Screenshots">
          <Grid Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center">
            <icons:OrbitIcon Kind="Screenshot" Width="20" Height="20" Stroke="{StaticResource IconBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Grid>
        </Button>
        <Button Classes="overlay-icon-button" x:Name="PerformanceButton" ToolTip.Tip="PC performance" Click="OnPerformanceClick" AutomationProperties.Name="PC performance">
          <Grid Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center">
            <icons:OrbitIcon Kind="Performance" Width="20" Height="20" Stroke="{StaticResource IconBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Grid>
        </Button>
        <Button Classes="overlay-icon-button" x:Name="MusicButton" ToolTip.Tip="Music" Click="OnMusicClick" AutomationProperties.Name="Music">
          <Grid Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center">
            <icons:OrbitIcon Kind="Music" Width="20" Height="20" Stroke="{StaticResource IconBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Grid>
        </Button>
      </StackPanel>

      <Border Grid.Column="3" Width="1" Height="26" Background="{StaticResource LineBrush}" Margin="18,0" />

      <Grid Grid.Column="4" ColumnDefinitions="40,40" Height="40" VerticalAlignment="Center">
        <Button Grid.Column="0" Classes="overlay-icon-button primary" ToolTip.Tip="New widgets" Click="OnWidgetsClick" AutomationProperties.Name="New widgets">
          <Grid Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center">
            <icons:OrbitIcon Kind="Marketplace" Width="18" Height="18" Stroke="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Grid>
        </Button>
        <Button Grid.Column="1" Classes="overlay-icon-button" ToolTip.Tip="Settings" Click="OnSettingsClick" AutomationProperties.Name="Settings">
          <Grid Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center">
            <icons:OrbitIcon Kind="Settings" Width="18" Height="18" Stroke="{StaticResource IconBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Grid>
        </Button>
      </Grid>
    </Grid>
  </Grid>
</Window>
